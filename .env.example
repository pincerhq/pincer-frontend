# Copy to `.env.local` and fill in. `VITE_`- and `SIGNUP_`-prefixed vars are
# served to the browser as /config.js: by the dev server from this file (see
# vite.config.ts), and by the container from its environment, set at container
# start. Nothing is inlined into the bundle, but all of it is public, so never
# give a secret either prefix.

# Optional: keep the Docs mock AI reachable for offline work.
# VITE_AI_MOCK=1

# ── Pincer ───────────────────────────────────────────────────────────────────
# The API both login pages sign in against (`POST /api/auth/login`). Unset means
# "same origin as this app". People sign in with their Pincer identity's name or
# email and password — there is no credential to configure here.
# VITE_PINCER_API_URL=http://localhost:8100

# ── Sign-up ──────────────────────────────────────────────────────────────────
# Set at container start. `true` adds /signup and the link to it on the login page;
# anything else leaves /signup a 404. The page is a "request access" form that
# opens a mail draft to the instance's administrator — the Pincer API has no
# registration endpoint, so this does not create accounts.
SIGNUP_ALLOWED=false
