# Copy to `.env.local` and fill in. Vite exposes `VITE_`- and `SIGNUP_`-prefixed
# vars to the browser (see `envPrefix` in vite.config.ts): they are inlined into
# the bundle, so never give a secret either prefix.

# ── Notes service (notes_app) ────────────────────────────────────────────────
# Base URL of the standalone Notes backend. Required — /notes makes no HTTP
# calls without it and shows a configuration error instead of an empty list.
#
# In dev use `/notes-api`, which the Vite proxy forwards to NOTES_API_TARGET.
# That keeps requests same-origin: the dev server is on :3000 and the service's
# cors_origins lists only :8080 and :5173, so a direct absolute URL fails its
# preflight. In production set the service's real origin — and make sure the
# backend's cors_origins includes the deployed frontend origin.
VITE_NOTES_API_URL=/notes-api
# NOTES_API_TARGET=http://localhost:8000

# Optional: a token dedicated to the Notes service. When unset, the signed-in
# Pincer session's access token (`pincer.web.auth`) is sent. Set this if your
# Notes service does not accept Pincer's per-identity tokens.
# VITE_NOTES_TOKEN=

# Optional: keep the Docs mock AI reachable for offline work.
# VITE_AI_MOCK=1

# ── Pincer ───────────────────────────────────────────────────────────────────
# The API both login pages sign in against (`POST /api/auth/login`). Unset means
# "same origin as this app". People sign in with their Pincer identity's name or
# email and password — there is no credential to configure here.
# VITE_PINCER_API_URL=http://localhost:8100

# ── Sign-up ──────────────────────────────────────────────────────────────────
# Build-time flag. `true` adds /signup and the link to it on the login page;
# anything else leaves /signup a 404. The page is a "request access" form that
# opens a mail draft to the instance's administrator — the Pincer API has no
# registration endpoint, so this does not create accounts.
SIGNUP_ALLOWED=false
