# Serves the built SPA and proxies /api to the Pincer API, so the browser sees
# one origin: no CORS, and the app's default "API = page origin" just works.
#
# Rendered by the nginx image's envsubst step at container start; the only
# variable is ${PINCER_API_UPSTREAM} (see the Dockerfile).
#
# /config.js is the app's runtime configuration, written to /tmp at container
# start from the VITE_* and SIGNUP_* variables (docker/40-runtime-env.sh).

map $http_upgrade $connection_upgrade {
    default upgrade;
    ""      close;
}

server {
    listen 8080;
    server_name _;

    root /usr/share/nginx/html;
    index index.html;

    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;

    location = /healthz {
        access_log off;
        default_type text/plain;
        return 200 "ok\n";
    }

    # REST, the SSE streams (/api/chat/stream, /api/approvals/stream) and the
    # listen-in WebSocket (/api/voice/listen/*).
    location /api/ {
        proxy_pass ${PINCER_API_UPSTREAM};
        proxy_http_version 1.1;

        proxy_set_header Host $host;
        # Pincer's sign-in lockout is per client IP: without this every user
        # would share nginx's address, and one person's failures lock out all.
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;

        # Streams must reach the browser as they are written, and stay open.
        proxy_buffering off;
        proxy_read_timeout 1h;
        proxy_send_timeout 1h;

        client_max_body_size 25m;
    }

    # Runtime configuration (window.__ENV__). Never cached, so a restart with
    # new values reaches the browser on the next page load.
    location = /config.js {
        alias /tmp/config.js;
        default_type application/javascript;
        add_header Cache-Control "no-store";
        add_header X-Content-Type-Options "nosniff" always;
    }

    # Fingerprinted by Vite: safe to cache forever.
    location /assets/ {
        add_header Cache-Control "public, max-age=31536000, immutable";
        add_header X-Content-Type-Options "nosniff" always;
        try_files $uri =404;
    }

    # Client-side routes: anything that is not a file is the app.
    location / {
        add_header Cache-Control "no-cache";
        add_header X-Content-Type-Options "nosniff" always;
        add_header Referrer-Policy "strict-origin-when-cross-origin" always;
        try_files $uri /index.html;
    }
}
